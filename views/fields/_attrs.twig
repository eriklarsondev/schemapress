{#
  Shared attributes for every field.

  In the editor each field is tagged with its key so the rendered layout can be
  clicked into, and marked when it is showing sample content rather than
  something someone wrote. Neither attribute is emitted on a delivered page.
#}
class="sp-field sp-field--{{ field.key }}{{ extra ? ' ' ~ extra : '' }}{% if field.classes %} {{ field.classes }}{% endif %}{% if field.empty and field.editing %} sp-sample{% endif %}"
{%- if field.editing %} data-sp-field="{{ field.key }}"{% endif %}
{#- plain-text kinds can be typed into directly. rich text cannot: it is
    markup, and editing it as text would flatten the markup to a string -#}
{%- if field.editing and field.kind in ['heading', 'eyebrow', 'text'] %} data-sp-inline="1"{% endif %}
