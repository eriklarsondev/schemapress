{# A resolved attachment. Sizes come from the delivered payload. #}
<figure {% include 'fields/_attrs.twig' with { field: field, extra: 'sp-image' } only %}>
	<img
		src="{{ field.value.sizes.large.url|default(field.value.url) }}"
		{% if field.value.srcset %}srcset="{{ field.value.srcset }}"{% endif %}
		{% if field.value.width %}width="{{ field.value.width }}"{% endif %}
		{% if field.value.height %}height="{{ field.value.height }}"{% endif %}
		alt="{{ field.value.alt }}"
		loading="lazy" />

	{% if field.value.caption %}
		<figcaption class="sp-caption">{{ field.value.caption }}</figcaption>
	{% endif %}
</figure>
