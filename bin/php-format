#!/bin/sh
#
# PHP-CS-Fixer over the files given, for the pre-commit hook.
#
# Two things the bare command cannot do from lint-staged:
#
# 1. PHP-CS-Fixer refuses to run on more than one path without an explicit
#    --config ("For multiple paths config parameter is required"). Handed a
#    single staged file it discovers the config by itself and works, so this
#    breaks only once a commit touches two PHP files — which is to say almost
#    immediately, and with an error that says nothing about the cause.
#
# 2. Passing --config by hand would pin the hook to the .dist file and quietly
#    ignore a local .php-cs-fixer.php override, which is the one thing that
#    file exists to do. So the choice is made here, the same way the tool makes
#    it: the local config if there is one, the committed default otherwise.
#
# --path-mode=intersection keeps the finder in the config authoritative — a
# staged file the config excludes stays excluded rather than being pulled in
# because it was named on the command line.
#
#
# ON A MISSING FORMATTER
#
# A contributor who cloned and ran `npm install` but not `composer install` has
# no formatter, and refusing their commit over it helps nobody. Say so plainly
# and let it through: CI runs the formatting check on every push and fails
# there if this pass skipped something that needed it.
#
# This used to be far more involved, because vendor/ was committed and could be
# left in states where the binary was present but unusable. It is gitignored
# now, so the file being there means it works.

fixer=vendor/bin/php-cs-fixer

if [ ! -x "$fixer" ]; then
	echo ""
	echo "  PHP formatting skipped: php-cs-fixer is not installed."
	echo "  Run 'composer install'. CI checks formatting regardless."
	echo ""

	exit 0
fi

config=.php-cs-fixer.php
[ -f "$config" ] || config=.php-cs-fixer.dist.php

exec "$fixer" fix \
	--config="$config" \
	--path-mode=intersection \
	--quiet \
	-- "$@"
