{
  "name": "schemapress",
  "version": "0.2.0",
  "author": "Erik Larson",
  "description": "Define reusable page content schemas and bind them to page templates",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "npm run format:js && npm run format:php",
    "format:js": "prettier --write .",
    "format:php": "vendor/bin/php-cs-fixer fix",
    "format:check": "npm run format:js:check && npm run format:php:check",
    "format:js:check": "prettier --check .",
    "format:php:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "lint:js": "eslint . --ext .js",
    "lint:php": "vendor/bin/phpcs --standard=phpcs.xml.dist",
    "lint:php:fix": "vendor/bin/phpcbf --standard=phpcs.xml.dist",
    "lint:php:syntax": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 -P4 php -l",
    "test": "php tests/run.php",
    "pot": "php bin/make-pot.php",
    "package": "php bin/package.php",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,css,json,yml,yaml}": "prettier --write --ignore-unknown",
    "*.php": [
      "bin/php-lint",
      "bin/php-format"
    ]
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.7.0",
    "autoprefixer": "^10.5.4",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@wordpress/icons": "^15.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "prismjs": "^1.30.0",
    "tailwind-merge": "^3.6.0"
  }
}
