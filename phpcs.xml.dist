<?xml version="1.0"?>
<ruleset name="SchemaPress">
    <description>
        The checks a wordpress.org review blocks on.

        NOT the full WordPress standard. That one is largely about house style —
        Yoda conditions, snake_case method names, alignment — and this codebase
        has its own, stated in README.md. Running it here would bury the findings
        that matter under a few thousand that do not, which is the reliable way
        to get a linter switched off.

        What is left is the set that decides whether a plugin is accepted:
        escaping, sanitising, nonces, capabilities, prepared SQL, prefixes, and
        the PHP versions the header promises to run on.

        Run: composer lint
    </description>

    <file>.</file>

    <!-- committed for distribution, not written here -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>

    <!-- neither ships: see .distignore. the suite is a plain script that stubs
         WordPress, so it declares functions in the global namespace on purpose
         and every prefix rule in here is wrong about it -->
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/bin/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP"/>
    <rule ref="WordPress.CodeAnalysis"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>

    <!-- EVERY QUERY IN THIS PLUGIN IS A META QUERY, which is what the sniff
         exists to discourage and what this plugin is for. A collection's values
         are one JSON blob per entry; class-index.php mirrors every scalar into
         its own meta row precisely so that SQL can reach it, and filtering or
         sorting a collection is then a meta_query against those rows. There is
         no version of this plugin that does not do it.

         Excluded here rather than annotated at sixteen call sites, so the
         reasoning is in one place and a reviewer reads it once. -->
    <rule ref="WordPress.DB.SlowDBQuery">
        <severity>0</severity>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="schemapress"/>
                <element value="SchemaPress"/>
            </property>
        </properties>
    </rule>

    <!-- 8.2 is the floor the plugin header declares, because Timber 2 needs it -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.2-"/>
    <config name="minimum_wp_version" value="6.2"/>
</ruleset>
